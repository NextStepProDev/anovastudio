[Unit]
Description=Anova Studio: ports 80/443 only from Cloudflare (DOCKER-USER)
# iptables rules do not survive a server restart — this service restores them once
# Docker is up. PartOf: a Docker restart runs it again.
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/anova-origin-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target docker.service
