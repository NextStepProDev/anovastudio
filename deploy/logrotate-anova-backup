# Rotation of the nightly backup's log.
#
# rclone appends to it on every run and nothing trims it. It grows slowly, on the disk
# shared with the database — and a full disk is exactly what breaks the backup this log
# describes.
#
# Installed to /etc/logrotate.d/anova-backup by deploy.yml.

/var/log/anova-backup.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    # copytruncate, not create: rclone keeps the file open through --log-file, so with an
    # ordinary rename it would keep writing to the deleted file.
    copytruncate
}
