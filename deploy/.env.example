# Copy to .env on the production server (in the deploy directory) and fill in.
# Generate secrets with: openssl rand -base64 32

# --- Database ---
POSTGRES_DB=anovastudio
POSTGRES_USER=anovastudio
POSTGRES_PASSWORD=CHANGE_TO_STRONG_PASSWORD

# --- Strapi secrets (each different, randomly generated) ---
# APP_KEYS is four keys separated by commas
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# --- Public addresses ---
# Must match server_name in nginx.conf
STRAPI_PUBLIC_URL=https://api.anovastudio.pl

# Allowed CORS origins (comma-separated). Optional — by default the code accepts the
# production domains + localhost:3000. Set only when it has to be overridden.
# CORS_ORIGINS=https://anovastudio.pl,https://www.anovastudio.pl

# --- Images (GHCR) ---
GHCR_OWNER=nextstepprodev
# Overwritten by deploy.yml with the value of the VERSION file in the repo
VERSION=latest
