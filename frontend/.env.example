# Base URL of the Strapi backend (no trailing slash)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Public base URL of the site — drives canonical links, sitemap.xml, robots.txt
# and the social card address. Baked into the image at BUILD time (CI passes the
# SITE_URL repository variable), so a wrong value silently points the whole site
# at localhost. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
